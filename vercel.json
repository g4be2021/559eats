{
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/truck/([0-9a-f-]{36})/?",
      "dest": "/api/seo?type=truck&id=$1"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/api/seo?type=sitemap"
    },
    {
      "src": "/food-trucks/([a-z-]+)/?",
      "dest": "/api/seo?type=landing&page=$1"
    },
    {
      "src": "/(.*)",
      "dest": "/404.html",
      "status": 404
    }
  ],
  "crons": [
    {
      "path": "/api/subscribe?a=sync",
      "schedule": "17 13 * * *"
    }
  ]
}